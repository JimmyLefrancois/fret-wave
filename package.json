{
  "name": "fretwave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy": "npm run build && wrangler d1 migrations apply fretwave --remote && wrangler deploy",
    "test": "vitest run",
    "shots": "node tools/screenshot.mjs",
    "sim:report": "SIM_REPORT=1 vitest run tests/simReport.test.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "pitchy": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tonal": "^6.5.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
