    "typographyMeta": {
      "display": {
        "displayName": "Display",
        "purpose": "Marque et mot-symbole (Press Start 2P), titre de page `main.wide h1` ; sans minuscules, jamais pour du texte lu."
      },
      "title": {
        "displayName": "Titre",
        "purpose": "Titre de carte et titre d’élément dans une liste (sans-serif système, 650)."
      },
      "body": {
        "displayName": "Corps",
        "purpose": "Explications et consignes, tout ce qui se lit ; `.t-small` à 14,5 px en atténué."
      },
      "label": {
        "displayName": "Étiquette",
        "purpose": "Étiquettes de panneau, tags, badges (Silkscreen 11 px, capitales)."
      },
      "hero-title": {
        "displayName": "Titre de la tâche",
        "purpose": "La gamme ou l’accord du héros de l’accueil : le plus grand mot de l’accueil (30 px, 36 px au bureau)."
      },
      "label-lg": {
        "displayName": "Étiquette large",
        "purpose": "Étiquettes lues à un mètre : héros de l’accueil et accroche de l’affiche (13 px)."
      }
    },
    "shadows": [
      {
        "name": "panel",
        "value": "var(--shadow) var(--shadow) 0 var(--shadow-ink)",
        "purpose": "Repos des panneaux (--shadow = 4 px ; encre noire à 45 % la nuit, magenta à 28 % à l’aube)."
      },
      {
        "name": "button",
        "value": "3px 3px 0 var(--shadow-ink)",
        "purpose": "Repos des boutons."
      },
      {
        "name": "button-pressed",
        "value": "1px 1px 0 var(--shadow-ink)",
        "purpose": "Bouton enfoncé (avec translate(2px, 2px))."
      },
      {
        "name": "neon-primary",
        "value": "0 0 0 2px var(--bg-deep), 0 0 20px -4px var(--magenta), 3px 3px 0 var(--shadow-ink)",
        "purpose": "Action principale : liseré nuit, halo magenta, ombre dure."
      },
      {
        "name": "neon-panel",
        "value": "0 0 16px -6px var(--accent), var(--shadow) var(--shadow) 0 var(--shadow-ink)",
        "purpose": "Panneau mis en avant (bordure à l’accent du module)."
      }
    ],
    "motion": [
      {
        "name": "press",
        "value": "60ms steps(1)",
        "purpose": "Enfoncement d’un bouton (transform et ombre), sans interpolation."
      },
      {
        "name": "pulse",
        "value": "1.6s steps(2, end) infinite",
        "purpose": "Témoin du micro allumé, clignotement pixel."
