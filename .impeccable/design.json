  "components": [
    {
      "name": "Bouton",
      "kind": "button",
      "refersTo": "button",
      "description": "Bouton par défaut : surface haute, capitales, ombre dure qui s’enfonce à l’appui.",
      "html": "<button class=\"ds-btn\">Improviser</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 14px;font-family:var(--font-body);font-weight:650;font-size:13.5px;letter-spacing:.04em;text-transform:uppercase;background:var(--surface-hi);color:var(--text);border:var(--bw) solid var(--line);box-shadow:3px 3px 0 var(--shadow-ink);cursor:pointer;transition:transform 60ms steps(1),box-shadow 60ms steps(1)}.ds-btn:hover{border-color:var(--cyan)}.ds-btn:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}.ds-btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--shadow-ink)}.ds-btn:disabled{opacity:.4;cursor:default;transform:none}"
    },
    {
